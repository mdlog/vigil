# Copy to .env (gitignored) and fill in. forge loads .env automatically.

# Deployer key for `forge script script/Deploy.s.sol --broadcast`. Leave empty to pass --private-key/--account instead.
# Testnet ETH: https://faucet.testnet.chain.robinhood.com
PRIVATE_KEY=

# Optional: on-chain dependencies. Empty = deploy a mock (testnet 46630 has none of these).
# Mainnet 4663 values are listed in the header of script/Deploy.s.sol.
MORPHO=
IRM=
USDG=
STOCK_TOKEN=
FEED=
USDG_FEED=

# Optional: role holders (default = deployer) and market parameters (defaults shown).
GUARDIAN=
CALIBRATOR=
KEEPER_SIGNER=
#LLTV=860000000000000000
#TARGET_LTV=760000000000000000
#CAP_BPS=500
#COVERAGE_CAP=100000000000
